            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Net Cash Flow From Operations"
        }
      },
      "title": "CashFlow",
      "type": "object"
    },
    "Company": {
      "additionalProperties": false,
      "description": "Who the company is, and the figures per-share and enterprise-value maths need.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "exchange": {
          "anyOf": [
            {
              "maxLength": 30,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "industry": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Industry"
        },
        "market_cap": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Cap"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "sector": {
          "anyOf": [
            {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "shares_outstanding": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shares Outstanding"
        },
        "source": {
          "enum": [
            "sec_xbrl",
            "financial_datasets",
            "getmarketalerts"
          ],
          "title": "Source",
          "type": "string"
        },
        "ticker": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "currency",
        "source",
        "as_of"
      ],
      "title": "Company",
      "type": "object"
    },
    "EarningsReport": {
      "additionalProperties": false,
      "description": "One reported quarter. Estimates may be null: not every feed has them.",
      "properties": {
        "eps_actual": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000.0,
              "exclusiveMinimum": -1000000.0,
              "type": "number"
