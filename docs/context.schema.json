          "maxItems": 26,
          "title": "Balance",
          "type": "array"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "fiscal_year_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
