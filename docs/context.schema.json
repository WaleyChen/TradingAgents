            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shareholders Equity"
        },
        "source": {
          "enum": [
            "sec_xbrl",
            "financial_datasets",
            "getmarketalerts"
          ],
          "title": "Source",
          "type": "string"
        },
        "total_assets": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Assets"
        },
        "total_debt": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Debt"
        },
        "total_liabilities": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
