        },
        "gross_profit": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gross Profit"
