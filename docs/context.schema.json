        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "fiscal_period": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Fiscal Period",
          "type": "string"
        }
      },
      "required": [
        "date",
        "fiscal_period",
        "confirmed"
      ],
      "title": "NextEarnings",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "description": "A verified closing price, so the service can derive valuation ratios.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "close": {
          "exclusiveMaximum": 10000000.0,
          "exclusiveMinimum": 0,
          "title": "Close",
          "type": "number"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "source": {
          "enum": [
            "sec_xbrl",
            "financial_datasets",
            "getmarketalerts"
