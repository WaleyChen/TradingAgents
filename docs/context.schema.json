  "additionalProperties": false,
  "description": "What a caller supplies with a request. Only the blocks defined here are accepted.",
  "properties": {
    "company": {
      "anyOf": [
        {
          "$ref": "#/$defs/Company"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "events": {
      "anyOf": [
        {
          "$ref": "#/$defs/Events"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "financials": {
