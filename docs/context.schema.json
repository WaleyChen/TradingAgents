          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "cash_and_equivalents": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cash And Equivalents"
        },
        "current_assets": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Assets"
        },
        "current_liabilities": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Liabilities"
        },
        "fiscal_period": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Fiscal Period",
          "type": "string"
