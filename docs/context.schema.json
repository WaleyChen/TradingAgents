        "kind": {
          "enum": [
            "standalone",
            "ytd",
            "annual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
