              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Liabilities"
        }
      },
      "required": [
        "fiscal_period",
        "as_of",
        "source"
      ],
      "title": "Balance",
      "type": "object"
    },
    "CashFlow": {
      "additionalProperties": false,
      "properties": {
        "capital_expenditure": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capital Expenditure"
        },
        "free_cash_flow": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000000,
              "exclusiveMinimum": -1000000000000000,
