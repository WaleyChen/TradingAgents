        "fiscal_period": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Fiscal Period",
          "type": "string"
        },
        "income": {
          "anyOf": [
            {
              "$ref": "#/$defs/Income"
            },
            {
              "type": "null"
            }
          ],
          "default": null
